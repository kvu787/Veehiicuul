<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <Optimize>true</Optimize>
        <UseSharedCompilation>false</UseSharedCompilation>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AssemblyName>ShaderUnderstandingApp</AssemblyName>
        <RootNamespace>ShaderUnderstanding</RootNamespace>
        <ApplicationManifest>Source/Application.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Tests/**;Source/ShaderMathematics/**" />
        <ProjectReference Include="Source/ShaderMathematics/ShaderMathematics.csproj" />
        <AssemblyMetadata Include="ApplicationDirectory" Value="$(MSBuildProjectDirectory)" />
    </ItemGroup>
</Project>
