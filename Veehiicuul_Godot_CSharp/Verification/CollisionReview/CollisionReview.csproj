<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Optimize>true</Optimize>
        <UseSharedCompilation>false</UseSharedCompilation>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputPath>MyBuildOutput/Managed/</OutputPath>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="Engine/**/*.cs;MyBuildOutput/**/*.cs" />
        <Compile Include="../../Veehiicuul/Source/GameDataAndLogic/CollisionDetection/TrackCollisionDetector*.cs" Link="Production/%(Filename)%(Extension)" />
        <Compile Include="../../Veehiicuul/Source/GameDataAndLogic/CollisionDetection/ColliderJson.cs" Link="Production/ColliderJson.cs" />
        <Compile Include="../../Veehiicuul/Source/GameDataAndLogic/CollisionDetection/Outline.cs" Link="Production/Outline.cs" />
        <Compile Include="../../Veehiicuul/Source/GameDataAndLogic/CollisionDetection/CoordinateXY.cs" Link="Production/CoordinateXY.cs" />
        <Compile Include="../../Veehiicuul/Source/GameDataAndLogic/CollisionDetection/Guard.cs" Link="Production/Guard.cs" />
    </ItemGroup>
</Project>
