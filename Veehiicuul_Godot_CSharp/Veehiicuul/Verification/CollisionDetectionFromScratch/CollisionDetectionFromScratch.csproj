<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>CollisionDetectionFromScratch</RootNamespace>
        <AssemblyName>CollisionDetectionFromScratch</AssemblyName>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <UseSharedCompilation>false</UseSharedCompilation>
        <!-- Required by the generated marshalling code for the processor topology query. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Workstation, nonconcurrent collection keeps background threads out of timed regions. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="MyLogOutput/**" />
        <Compile Remove="NativeProject/**" />
        <!--
            The only inputs taken from the application are the collision detection sources.
            VehicleCollisionFootprint.cs and CollisionManager.cs need the Godot engine and are
            compiled by NativeProject instead.
        -->
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/ColliderJson.cs" Link="Production/ColliderJson.cs" />
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/CoordinateXY.cs" Link="Production/CoordinateXY.cs" />
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/Guard.cs" Link="Production/Guard.cs" />
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/Outline.cs" Link="Production/Outline.cs" />
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/TrackCollisionDetector.cs" Link="Production/TrackCollisionDetector.cs" />
        <Compile Include="../../Source/GameDataAndLogic/CollisionDetection/TrackCollisionDetector.ExpandedGrid.cs" Link="Production/TrackCollisionDetector.ExpandedGrid.cs" />
    </ItemGroup>
</Project>
