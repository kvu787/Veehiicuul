{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Out/Build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "vs-release",
      "displayName": "Windows x64 Release",
      "inherits": "vs-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs-debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs-release"
    }
  ],
  "testPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs-release",
      "configurePreset": "vs-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
